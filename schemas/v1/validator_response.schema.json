{
  "$defs": {
    "Aggregate": {
      "additionalProperties": false,
      "properties": {
        "aggregates": {
          "items": {
            "type": "string"
          },
          "title": "Aggregates",
          "type": "array"
        },
        "group_by": {
          "items": {
            "type": "string"
          },
          "title": "Group By",
          "type": "array"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "Aggregate",
          "title": "Operator Type",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "group_by",
        "aggregates"
      ],
      "title": "Aggregate",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "operator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator Id"
        },
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "ExportRequest": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "json",
                "csv",
                "parquet"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "requested": {
          "default": false,
          "title": "Requested",
          "type": "boolean"
        }
      },
      "title": "ExportRequest",
      "type": "object"
    },
    "Filter": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "title": "Expression",
          "type": "string"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "Filter",
          "title": "Operator Type",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "expression"
      ],
      "title": "Filter",
      "type": "object"
    },
    "GeneralizeLocation": {
      "additionalProperties": false,
      "description": "Reduce disclosed location detail without changing prior selection.\n\nThe logical contract maps the named spatial fields to deterministic fixed\ngrid cells of approximately ``precision_km``. It preserves record\nmembership: for example, a preceding 50 km SpatialFilter remains a 50 km\nquery. Physical coordinate transformation is deliberately deferred to the\ntrusted execution layer.",
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "method": {
          "const": "fixed_grid",
          "default": "fixed_grid",
          "title": "Method",
          "type": "string"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "GeneralizeLocation",
          "title": "Operator Type",
          "type": "string"
        },
        "precision_km": {
          "exclusiveMinimum": 0,
          "title": "Precision Km",
          "type": "number"
        },
        "preserves_selection": {
          "const": true,
          "default": true,
          "title": "Preserves Selection",
          "type": "boolean"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "fields",
        "precision_km"
      ],
      "title": "GeneralizeLocation",
      "type": "object"
    },
    "Join": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "join_type": {
          "default": "inner",
          "enum": [
            "inner",
            "left"
          ],
          "title": "Join Type",
          "type": "string"
        },
        "left_field": {
          "title": "Left Field",
          "type": "string"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "Join",
          "title": "Operator Type",
          "type": "string"
        },
        "right_field": {
          "title": "Right Field",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "left_field",
        "right_field"
      ],
      "title": "Join",
      "type": "object"
    },
    "LineageCapture": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/LineageLevel"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "LineageCapture",
          "title": "Operator Type",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "level"
      ],
      "title": "LineageCapture",
      "type": "object"
    },
    "LineageLevel": {
      "enum": [
        "none",
        "source",
        "record"
      ],
      "title": "LineageLevel",
      "type": "string"
    },
    "Mask": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "method": {
          "default": "redact",
          "enum": [
            "redact",
            "hash",
            "null"
          ],
          "title": "Method",
          "type": "string"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "Mask",
          "title": "Operator Type",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "fields"
      ],
      "title": "Mask",
      "type": "object"
    },
    "MinGroupSize": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "minimum_count": {
          "minimum": 2,
          "title": "Minimum Count",
          "type": "integer"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "MinGroupSize",
          "title": "Operator Type",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "minimum_count"
      ],
      "title": "MinGroupSize",
      "type": "object"
    },
    "ObligationType": {
      "enum": [
        "VERSION_PIN",
        "MASK",
        "GENERALIZE_LOCATION",
        "MIN_GROUP_SIZE",
        "EXPORT_CONTROL",
        "LINEAGE_CAPTURE"
      ],
      "title": "ObligationType",
      "type": "string"
    },
    "PolicyDecision": {
      "description": "XACML-inspired policy decisions; not TrustAero validation outcomes.",
      "enum": [
        "PERMIT",
        "DENY",
        "INDETERMINATE",
        "NOT_APPLICABLE"
      ],
      "title": "PolicyDecision",
      "type": "string"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "Project",
          "title": "Operator Type",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "fields"
      ],
      "title": "Project",
      "type": "object"
    },
    "ReasonCode": {
      "description": "Machine-stable diagnostics; messages are intentionally not the API key.",
      "enum": [
        "PLAN_PARSE_ERROR",
        "MISSING_REQUIRED_FIELD",
        "UNKNOWN_OPERATOR",
        "INVALID_OPERATOR_ARGUMENT",
        "DUPLICATE_OPERATOR_ID",
        "UNBOUND_REFERENCE",
        "CYCLIC_PLAN",
        "UNREACHABLE_OPERATOR",
        "OUTPUT_OPERATOR_UNKNOWN",
        "UNKNOWN_DATASET",
        "UNKNOWN_FIELD",
        "PURPOSE_MISSING",
        "POLICY_DENIED",
        "POLICY_INDETERMINATE",
        "POLICY_NOT_APPLICABLE",
        "POLICY_CONFLICT",
        "VERSION_UNRESOLVED",
        "SPATIAL_PRECISION_EXCEEDED",
        "MASK_REQUIRED",
        "MIN_GROUP_SIZE_REQUIRED",
        "EXPORT_FORBIDDEN",
        "LINEAGE_REQUIRED",
        "OBLIGATION_CONFLICT",
        "REWRITE_CYCLE_DETECTED",
        "REWRITE_DID_NOT_CONVERGE"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RequestContext": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "read",
            "join",
            "aggregate",
            "export"
          ],
          "title": "Action",
          "type": "string"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "query_time_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        }
      },
      "required": [
        "subject",
        "action"
      ],
      "title": "RequestContext",
      "type": "object"
    },
    "RequestedOutput": {
      "additionalProperties": false,
      "properties": {
        "export": {
          "$ref": "#/$defs/ExportRequest"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "lineage_level": {
          "$ref": "#/$defs/LineageLevel",
          "default": "none"
        }
      },
      "required": [
        "fields"
      ],
      "title": "RequestedOutput",
      "type": "object"
    },
    "ScanSource": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "ScanSource",
          "title": "Operator Type",
          "type": "string"
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "dataset"
      ],
      "title": "ScanSource",
      "type": "object"
    },
    "SnapshotBindings": {
      "additionalProperties": false,
      "properties": {
        "data_snapshots": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Data Snapshots",
          "type": "object"
        },
        "policy_snapshot": {
          "title": "Policy Snapshot",
          "type": "string"
        }
      },
      "required": [
        "policy_snapshot",
        "data_snapshots"
      ],
      "title": "SnapshotBindings",
      "type": "object"
    },
    "SpatialFilter": {
      "additionalProperties": false,
      "description": "Select records inside a query area.\n\n``radius_km`` controls which records belong to the result. Governance\nrewrites must not reinterpret it as an output-privacy parameter.",
      "properties": {
        "center": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "crs": {
          "default": "EPSG:4326",
          "title": "Crs",
          "type": "string"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "SpatialFilter",
          "title": "Operator Type",
          "type": "string"
        },
        "radius_km": {
          "exclusiveMinimum": 0,
          "title": "Radius Km",
          "type": "number"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "center",
        "radius_km"
      ],
      "title": "SpatialFilter",
      "type": "object"
    },
    "SpatialJoin": {
      "additionalProperties": false,
      "properties": {
        "distance_km": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distance Km"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "SpatialJoin",
          "title": "Operator Type",
          "type": "string"
        },
        "relation": {
          "enum": [
            "intersects",
            "within",
            "distance_within"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "relation"
      ],
      "title": "SpatialJoin",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "role"
      ],
      "title": "Subject",
      "type": "object"
    },
    "TemporalFilter": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "operator_type": {
          "const": "TemporalFilter",
          "title": "Operator Type",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "operator_type",
        "field",
        "start",
        "end"
      ],
      "title": "TemporalFilter",
      "type": "object"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "event_time",
            "valid_time",
            "publication_time"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "ValidatedLogicalPlan": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "$ref": "#/$defs/SnapshotBindings"
        },
        "candidate_plan_id": {
          "title": "Candidate Plan Id",
          "type": "string"
        },
        "logical_plan_id": {
          "title": "Logical Plan Id",
          "type": "string"
        },
        "operators": {
          "items": {
            "discriminator": {
              "mapping": {
                "Aggregate": "#/$defs/Aggregate",
                "Filter": "#/$defs/Filter",
                "GeneralizeLocation": "#/$defs/GeneralizeLocation",
                "Join": "#/$defs/Join",
                "LineageCapture": "#/$defs/LineageCapture",
                "Mask": "#/$defs/Mask",
                "MinGroupSize": "#/$defs/MinGroupSize",
                "Project": "#/$defs/Project",
                "ScanSource": "#/$defs/ScanSource",
                "SpatialFilter": "#/$defs/SpatialFilter",
                "SpatialJoin": "#/$defs/SpatialJoin",
                "TemporalFilter": "#/$defs/TemporalFilter"
              },
              "propertyName": "operator_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ScanSource"
              },
              {
                "$ref": "#/$defs/SpatialFilter"
              },
              {
                "$ref": "#/$defs/TemporalFilter"
              },
              {
                "$ref": "#/$defs/Filter"
              },
              {
                "$ref": "#/$defs/Join"
              },
              {
                "$ref": "#/$defs/SpatialJoin"
              },
              {
                "$ref": "#/$defs/Project"
              },
              {
                "$ref": "#/$defs/Aggregate"
              },
              {
                "$ref": "#/$defs/Mask"
              },
              {
                "$ref": "#/$defs/GeneralizeLocation"
              },
              {
                "$ref": "#/$defs/MinGroupSize"
              },
              {
                "$ref": "#/$defs/LineageCapture"
              }
            ]
          },
          "title": "Operators",
          "type": "array"
        },
        "output_operator": {
          "title": "Output Operator",
          "type": "string"
        },
        "request_context": {
          "$ref": "#/$defs/RequestContext"
        },
        "requested_output": {
          "$ref": "#/$defs/RequestedOutput"
        },
        "satisfied_obligations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObligationType"
          },
          "title": "Satisfied Obligations",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/ValidationSummary"
        }
      },
      "required": [
        "logical_plan_id",
        "candidate_plan_id",
        "request_context",
        "requested_output",
        "operators",
        "output_operator",
        "bindings",
        "validation"
      ],
      "title": "ValidatedLogicalPlan",
      "type": "object"
    },
    "ValidationStatus": {
      "description": "TrustAero-defined handling states for a complete candidate plan.",
      "enum": [
        "ACCEPT",
        "REWRITE",
        "CLARIFY",
        "REJECT"
      ],
      "title": "ValidationStatus",
      "type": "string"
    },
    "ValidationSummary": {
      "additionalProperties": false,
      "properties": {
        "canonical_digest": {
          "title": "Canonical Digest",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "rounds": {
          "minimum": 1,
          "title": "Rounds",
          "type": "integer"
        }
      },
      "required": [
        "rounds",
        "canonical_digest"
      ],
      "title": "ValidationSummary",
      "type": "object"
    }
  },
  "$id": "https://trustaero.org/schemas/v1/validator_response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Plan Id"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "policy_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ValidationStatus"
    },
    "validated_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidatedLogicalPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "status"
  ],
  "title": "ValidatorResponse",
  "type": "object"
}
