      "obligations": [
        {
          "obligation_type": "VERSION_PIN",
          "parameters": {}
        },
        {
          "obligation_type": "LINEAGE_CAPTURE",
          "parameters": {"level": "source"}
        }
      ],
      "reason": "Research aggregation is permitted when evidence binds both public sources."
    },
    {
      "policy_id": "P-PUBLIC-DENY-REAL-DATA",
      "policy_version": "1",
      "subject_roles": ["public"],
      "purposes": ["research"],
      "actions": ["read", "aggregate"],
      "resources": [
        "bts_on_time_2024_01",
        "nyc_tlc_yellow_2024_01",
        "nyc_tlc_taxi_zones"
      ],
      "decision": "DENY",
      "obligations": [],
      "reason": "The real-data smoke policy is restricted to the research role."
    }
  ]
