  "rules": [
    {
      "policy_id": "P-BTS-RESEARCH-READ",
      "policy_version": "1",
      "subject_roles": ["researcher"],
      "purposes": ["research"],
      "actions": ["read"],
      "resources": ["bts_on_time_2024_01"],
      "decision": "PERMIT",
      "obligations": [
        {
          "obligation_type": "VERSION_PIN",
          "parameters": {}
        },
        {
          "obligation_type": "MASK",
          "parameters": {"fields": ["Tail_Number"], "method": "hash"}
        },
        {
          "obligation_type": "LINEAGE_CAPTURE",
          "parameters": {"level": "source"}
        }
      ],
      "reason": "Research output may expose only hashed aircraft identifiers with source lineage."
    },
    {
      "policy_id": "P-NYC-RESEARCH-AGGREGATE",
      "policy_version": "1",
      "subject_roles": ["researcher"],
      "purposes": ["research"],
      "actions": ["aggregate"],
      "resources": ["nyc_tlc_yellow_2024_01", "nyc_tlc_taxi_zones"],
