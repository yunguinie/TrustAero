{
  "schema_version": "1.0",
  "plan_id": "multisource-case-query-v1",
  "request_context": {
    "subject": {
      "subject_id": "case-study-researcher",
      "role": "infrastructure_researcher",
      "attributes": {}
    },
    "purpose": "risk_assessment",
    "action": "join",
    "query_time_window": {
      "dimension": "event_time",
      "start": "2024-01-01T00:00:00Z",
      "end": "2025-01-01T00:00:00Z"
    }
  },
  "requested_output": {
    "fields": [
      "event_id",
      "magnitude",
      "api_well_number",
      "well_type",
      "airport_id",
      "airport_name",
      "geoid",
      "place_name"
    ],
    "export": {
      "requested": false,
      "destination": null,
      "format": null
    },
    "lineage_level": "source"
  },
  "operators": [
    {
      "operator_type": "ScanSource",
      "operator_id": "earthquake-scan",
      "inputs": [],
      "dataset": "usgs_earthquake",
      "snapshot": null
    },
    {
      "operator_type": "TemporalFilter",
      "operator_id": "earthquake-time",
      "inputs": ["earthquake-scan"],
      "field": "event_time",
      "start": "2024-01-01T00:00:00Z",
      "end": "2025-01-01T00:00:00Z"
    },
    {
      "operator_type": "Filter",
      "operator_id": "earthquake-magnitude",
      "inputs": ["earthquake-time"],
      "expression": {
        "expression_type": "comparison",
        "operator": "ge",
        "left": {
          "expression_type": "field",
          "field": "magnitude"
        },
        "right": {
          "expression_type": "literal",
          "data_type": "float",
          "value": 2.5
        }
      }
    },
    {
      "operator_type": "ScanSource",
      "operator_id": "well-scan",
      "inputs": [],
      "dataset": "oil_gas_well",
      "snapshot": null
    },
    {
      "operator_type": "SpatialJoin",
      "operator_id": "earthquake-well-join",
      "inputs": ["earthquake-magnitude", "well-scan"],
      "relation": "distance_within",
      "left_fields": ["earthquake_latitude", "earthquake_longitude"],
      "right_fields": ["well_latitude", "well_longitude"],
      "distance_km": 25.0
    },
    {
      "operator_type": "ScanSource",
      "operator_id": "airport-scan",
      "inputs": [],
      "dataset": "airport",
      "snapshot": null
    },
    {
      "operator_type": "SpatialJoin",
      "operator_id": "earthquake-airport-join",
      "inputs": ["earthquake-well-join", "airport-scan"],
      "relation": "distance_within",
      "left_fields": ["earthquake_latitude", "earthquake_longitude"],
      "right_fields": ["airport_latitude", "airport_longitude"],
      "distance_km": 50.0
    },
    {
      "operator_type": "ScanSource",
      "operator_id": "city-scan",
      "inputs": [],
      "dataset": "city",
      "snapshot": null
    },
    {
      "operator_type": "SpatialJoin",
      "operator_id": "earthquake-city-join",
      "inputs": ["earthquake-airport-join", "city-scan"],
      "relation": "distance_within",
      "left_fields": ["earthquake_latitude", "earthquake_longitude"],
      "right_fields": ["city_latitude", "city_longitude"],
      "distance_km": 25.0
    },
    {
      "operator_type": "Project",
      "operator_id": "case-output",
      "inputs": ["earthquake-city-join"],
      "fields": [
        "event_id",
        "magnitude",
        "api_well_number",
        "well_type",
        "airport_id",
        "airport_name",
        "geoid",
        "place_name"
      ]
    },
    {
      "operator_type": "Sort",
      "operator_id": "case-sort",
      "inputs": ["case-output"],
      "keys": [
        {"field": "event_id", "direction": "asc"},
        {"field": "api_well_number", "direction": "asc"},
        {"field": "airport_id", "direction": "asc"},
        {"field": "geoid", "direction": "asc"}
      ]
    }
  ],
  "output_operator": "case-sort"
}
